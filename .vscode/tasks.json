{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: create venv and install packages",
      "type": "shell",
      "command": "python3 -m venv venv && ./venv/bin/python -m pip install -r requirements.txt",
      "windows": {
        "command": "python -m venv venv && venv\\Scripts\\python.exe -m pip install -r requirements.txt",
        "options": { "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] } }
      },
      "problemMatcher": []
    },
    {
      "label": "Train model",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["src/train.py"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run web app",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["app.py"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "unittest", "discover", "tests", "-v"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Re-create dataset",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["data/generate_dataset.py"],
      "problemMatcher": []
    }
  ]
}
